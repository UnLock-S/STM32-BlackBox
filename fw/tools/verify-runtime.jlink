// ─────────────────────────────────────────────────────────────────────────────
//  verify-runtime.jlink —— 真机运行验证（无外设条件下也能自证）
// ─────────────────────────────────────────────────────────────────────────────
//  做什么：
//    1) 擦写 Flash 并烧入 bin/sbb_app.hex
//    2) 复位运行 3 s → 暂停 → 读 s_heartbeat_count（心跳计数）
//    3) 再运行 3 s → 暂停 → 再读一次，比较是否递增
//    4) 每次都读 RCC_CSR(0x40021024) 看复位原因位：
//         bit29 IWDGRSTF  = 独立看门狗复位（若置位说明 IWDG 把我们复位了）
//         bit28 SFTRSTF   = 软件复位
//         bit27 PORRSTF   = 上电复位
//         bit26 PINRSTF   = 引脚/调试器复位
//
//  判读：
//    计数器两次读数递增 → ✅ 代码在真机运行、调度器活着、心跳任务在跑
//    计数器为 0 或不增长 → ✗ 卡死/复位循环（可能 IWDG 超时，或任务未建起来）
//    CSR 的 bit29 置位 → IWDG 触发过复位（喂狗周期问题）
//
//  占位符由调用脚本替换：__HEX__ / __COUNTER_ADDR__
// ─────────────────────────────────────────────────────────────────────────────

si SWD
speed 4000
device STM32F103C8
connect

r
h
loadfile "__HEX__"

r
g
Sleep 3000
h
mem32 __COUNTER_ADDR__, 1
mem32 0x40021024, 1

g
Sleep 3000
h
mem32 __COUNTER_ADDR__, 1
mem32 0x40021024, 1

g
qc
